# PII Guard — copy to .env:  cp .env.example .env   (then change PII_GUARD_KEY)
# Variables already set in the shell override this file: FILE_POLICY=extract ./scripts/up.sh
# No Anthropic/OpenAI API key belongs here: Claude Code keeps each developer's own subscription login.

# ── Gateway key ─────────────────────────────────────────────────────────────────────────────────
# Claude Code sends it as ANTHROPIC_CUSTOM_HEADERS="x-pii-guard-key: Bearer <value>". Use a long
# random value outside a local trial:  echo "sk-$(openssl rand -hex 32)"
PII_GUARD_KEY=sk-local-dev

# ── Detection policy (Claude Code proxy) ────────────────────────────────────────────────────────
# Entities replaced by placeholders, and entities that reject the whole request.
MASK_ENTITIES=PHONE_NUMBER,EMAIL_ADDRESS,CREDIT_CARD,VN_PHONE,VN_CCCD,VN_TAX_ID,INTERNAL_TERM,ADDRESS,BANK_ACCOUNT
BLOCK_ENTITIES=SECRET
# Minimum detector score (0-1). Lower = more masking, more false positives in code.
SCORE_THRESHOLD=0.75
# Copilot proxy threshold (its entity lists live in copilot_proxy/scrub.py defaults).
COPILOT_SCORE_THRESHOLD=0.75

# Internal terms always masked (hostnames, domains, project/customer code names), comma-separated.
INTERNAL_DENY_LIST=corp.local,internal.example.com,db-prod-01
# Exact strings never masked, comma-separated. Keep noreply@anthropic.com: Claude Code injects it
# into git attribution reminders, and masking text Claude Code injects makes Anthropic stall requests.
ALLOW_LIST=noreply@anthropic.com
# Base scores of the Vietnamese rules before the context boost. Below SCORE_THRESHOLD a match is masked
# only next to a context word (sđt, sdt, phone, hotline, zalo / cccd, cmnd / mst). Raise one to
# SCORE_THRESHOLD or above to mask it everywhere, at the cost of more false positives in code.
VN_PHONE_SCORE=0.72
VN_CCCD_SCORE=0.55
VN_TAX_ID_SCORE=0.48

# ── Files: images and documents sent by Claude Code ─────────────────────────────────────────────
# block   = replace every image/PDF with a notice (default, nothing unscanned leaves)
# extract = extract text with marker-pdf (starts the `extractor` service), mask it, send the text
# pass    = forward files unscanned (not recommended)
FILE_POLICY=block
# Extractor (only with FILE_POLICY=extract). Keep EXTRACT_OCR=off: the bundled image reads PDF text
# layers only; images and scanned pages are rejected (fail-closed). OCR needs extra model weights and
# an inference server that this image does not ship (plan.md section 8.6).
EXTRACT_OCR=off
EXTRACT_MAX_BYTES=20971520
EXTRACT_MAX_PAGES=100
EXTRACT_TIMEOUT_S=120
EXTRACT_MEMORY_LIMIT=8g
EXTRACT_CPU_LIMIT=4

# ── Optional SLM second opinion (adds SECRET / ADDRESS / BANK_ACCOUNT / INTERNAL_TERM / PERSON) ─
# Needs a GPU in practice: a 1.5B model on CPU takes ~25 s per call, far above SLM_TIMEOUT_S.
#   Host Ollama (GPU):  SLM_BASE_URL=http://host.docker.internal:11434/v1  (Ollama on 0.0.0.0)
#   Bundled container:  SLM_BASE_URL=http://ollama:11434/v1  (up.sh starts it and pulls the model)
ENABLE_SLM_GATE=0
SLM_BASE_URL=http://host.docker.internal:11434/v1
SLM_MODEL=qwen2.5:1.5b
SLM_TIMEOUT_S=4
SLM_MAX_WINDOWS=3
SLM_MAX_ADDED_SPANS=8

# ── Copilot proxy ───────────────────────────────────────────────────────────────────────────────
# Only hosts matching COPILOT_HOSTS are decrypted; leave unset for the defaults
# (*.githubcopilot.com, copilot-proxy.githubusercontent.com). Never add github.com / api.github.com.
# COPILOT_HOSTS=

# ── Image pins ──────────────────────────────────────────────────────────────────────────────────
PRESIDIO_ANALYZER_IMAGE=ghcr.io/data-privacy-stack/presidio-analyzer:2.2.362
PRESIDIO_ANONYMIZER_IMAGE=ghcr.io/data-privacy-stack/presidio-anonymizer:2.2.362
MITMPROXY_IMAGE=mitmproxy/mitmproxy:12.2.1
OLLAMA_IMAGE=ollama/ollama:0.12.6
TORCH_VERSION=2.14.1+cpu
